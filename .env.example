# Postgres connection (Neon / Supabase / RDS / local). Only standard Postgres is used.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wanora

# Better Auth. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional: Google sign-in (both or neither)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Object storage (optional locally via docker compose MinIO on :9000)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=wanora
# S3_REGION=auto
