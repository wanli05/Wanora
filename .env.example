# Postgres connection (Neon / Supabase / RDS / local). Only standard Postgres is used.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wanora

# Better Auth. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional: Google sign-in (both or neither)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Object storage for 証明写真 (production / shared MinIO).
# When ALL of these are unset, the app falls back to local disk under `.data/objects/`
# (gitignored) so photo upload still works in `pnpm dev`.
#
# Local MinIO (docker compose up -d → API :9000, console :9001):
#   1. Create bucket `wanora` in the console (or `mc mb`)
#   2. Uncomment below (defaults match docker-compose.yml)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=wanora
# S3_REGION=auto

# --- AI Assistant (Phase 1B B1b: mock default; openai optional) ---
# Defaults stay safe for CI: AI off + mock. Never put OPENAI_API_KEY in the browser.
# AI_ENABLED=false
# AI_PROVIDER=mock
# When AI_PROVIDER=openai, OPENAI_API_KEY is required. Default model candidate:
# AI_DEFAULT_MODEL=gpt-6.1-terra
# OPENAI_API_KEY=
# AI_OPENAI_TIMEOUT_MS=60000
# AI_OPENAI_MAX_OUTPUT_TOKENS=2048
# Worker lease must be > AI_OPENAI_TIMEOUT_MS + AI_WORKER_SETTLE_SLACK_MS
# (asserted at `pnpm ai:worker` / startAiWorker startup):
# AI_WORKER_LEASE_MS=90000
# AI_WORKER_SETTLE_SLACK_MS=15000
# AI_WORKER_SHUTDOWN_WAIT_MS=120000
# Soft caps for reserve + execute prompt build:
# AI_MAX_HISTORY_MESSAGES=40
# AI_MAX_INPUT_CHARS=100000
# Optional comma-separated allowlist (empty = no extra restrict beyond resolve):
# AI_ALLOWED_MODELS=gpt-6.1-terra
# Must match src/lib/ai/pricing/catalog.ts version:
# AI_PRICING_VERSION=2026-11-17
# Live paid smoke only when explicitly true — must stay false in CI:
# AI_LIVE_SMOKE=false
# AI_RATE_LIMIT_PER_MINUTE=10
# AI_DAILY_TOKEN_BUDGET=100000
# AI_DAILY_COST_BUDGET_USD=1
# Site-wide daily estimated cost cap (all users combined):
# AI_GLOBAL_DAILY_COST_BUDGET_USD=20
# AI_MAX_CONTEXT_CHARS=12000
# Soft-deleted chats are hard-deleted by an external scheduler after N days:
# AI_CHAT_HARD_DELETE_AFTER_DAYS=30
# Hours to hold uncertain reserved budget before reconcile release:
# AI_UNCERTAIN_RECONCILE_AFTER_HOURS=24
# Shared secret for POST /api/ai/admin/purge-deleted (or CLI); do not commit real values:
# AI_PURGE_SECRET=
# Local AI worker (`pnpm ai:worker`):
# AI_WORKER_HEALTH_PORT=8081
# AI_WORKER_POLL_MS=1000
# AI_WORKER_BATCH=1
# AI_WORKER_ID=

# --- Support / お問い合わせ (works with AI_ENABLED=false) ---
# SUPPORT_REPORTS_ENABLED=true
# SUPPORT_REPORT_RATE_LIMIT_PER_HOUR=10
# Maintainer notify: log (default) or webhook
# SUPPORT_NOTIFY_PROVIDER=log
# SUPPORT_NOTIFY_WEBHOOK_URL=https://hooks.example.com/wanora-support
# SUPPORT_NOTIFY_WEBHOOK_TOKEN=
# SUPPORT_NOTIFY_MAX_ATTEMPTS=3
# Test-only fault injection (ignored when NODE_ENV=production):
# SUPPORT_INJECT_FAULT=career_project_save

