# Postgres connection (Neon / Supabase / RDS / local). Only standard Postgres is used.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wanora

# Better Auth. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional: Google sign-in (both or neither)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Object storage for 証明写真 (production / shared MinIO).
# When ALL of these are unset, the app falls back to local disk under `.data/objects/`
# (gitignored) so photo upload still works in `pnpm dev`.
#
# Local MinIO (docker compose up -d → API :9000, console :9001):
#   1. Create bucket `wanora` in the console (or `mc mb`)
#   2. Uncomment below (defaults match docker-compose.yml)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=wanora
# S3_REGION=auto
