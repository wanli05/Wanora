{
  "name": "wanora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "better-auth": "^1.7.15",
    "docx": "^9.15.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.4",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "playwright-core": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  }
}
